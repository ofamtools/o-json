// o-json's default key rows (ochazuke bindings, JSONC): groups by "noun/mode" context, one row per line, {key, action, args, ...}. A key may repeat: the first row whose action is available answers, and an unavailable one passes the key on (t turns a key into an array, or an array back into a key, where the mapping still checks). On a restructure node > and < are prefixes only (> > and g > nest, < < moves out, > j and > k nest two nodes, S wraps); alone they do nothing, so they never reach the divider there: ctrl+w > < = resize it on both pages (> < = still do on the original tree and the viewer). The outline's tab, shift+tab, i and d d are unbound (d d deletes through node.delete, into the register, and keeps the document node; y y yanks, p / P put at the level they land on; over a V selection d and y answer at once, as d d and y y are not available then): nesting goes through the JSON rules (> > and < <) and renaming through r; o, O and a add a key with a placeholder opened selected (restructure.add-key). w writes a new file; W (restructure.write {force}) replaces an existing one without asking, and the source after one confirm. In the viewer the structure pane is the restructured tree (structure.editable): the node keys work there as on the restructure page, T (restructure.show) flips the structure and data panes between the original and the edited document, and w / W write the restructured document while the edited one is shown (on the original, w is viewer.write). In the edited view's data pane (data.editable) r / i edit a value in an inline input (enter or esc sets it), d d deletes it, o adds one after it, K renames its key in that object and p puts the register's value over it (value.*, value patches); where they are not available the keys pass on (p to viewer.paste). u / ctrl+r undo and redo from the data pane. q asks before quitting with edits no write saved; Q quits without asking. A user's bindings.json overrides them.
{
  "bindings": [
    {"context": "app/normal", "bindings": [
      {"key": "ctrl+w >", "action": "ochazuke.pane.grow", "hint": "ctrl+w >/< resize", "from": {"steps": "count"}},
      {"key": "ctrl+w <", "action": "ochazuke.pane.shrink", "from": {"steps": "count"}, "hidden": true},
      {"key": "ctrl+w =", "action": "ochazuke.pane.reset", "hidden": true}
    ]},
    {"context": "rows/normal", "bindings": [
      {"key": "j", "action": "rows.move", "args": {"motion": "down"}, "from": {"steps": "count"}},
      {"key": "down", "action": "rows.move", "args": {"motion": "down"}, "from": {"steps": "count"}},
      {"key": "k", "action": "rows.move", "args": {"motion": "up"}, "from": {"steps": "count"}},
      {"key": "up", "action": "rows.move", "args": {"motion": "up"}, "from": {"steps": "count"}},
      {"key": "ctrl+d", "action": "rows.move", "args": {"motion": "half-down"}, "from": {"steps": "count"}},
      {"key": "ctrl+u", "action": "rows.move", "args": {"motion": "half-up"}, "from": {"steps": "count"}},
      {"key": "ctrl+f", "action": "rows.move", "args": {"motion": "page-down"}, "from": {"steps": "count"}},
      {"key": "pgdown", "action": "rows.move", "args": {"motion": "page-down"}, "from": {"steps": "count"}},
      {"key": "ctrl+b", "action": "rows.move", "args": {"motion": "page-up"}, "from": {"steps": "count"}},
      {"key": "pgup", "action": "rows.move", "args": {"motion": "page-up"}, "from": {"steps": "count"}},
      {"key": "g g", "action": "rows.move", "args": {"motion": "top"}, "from": {"line": "line"}},
      {"key": "home", "action": "rows.move", "args": {"motion": "top"}, "from": {"line": "line"}},
      {"key": "G", "action": "rows.move", "args": {"motion": "bottom"}, "from": {"line": "line"}},
      {"key": "end", "action": "rows.move", "args": {"motion": "bottom"}, "from": {"line": "line"}},
      {"key": "h", "action": "ochazuke.list.column", "args": {"delta": -1}, "from": {"steps": "count"}},
      {"key": "left", "action": "ochazuke.list.column", "args": {"delta": -1}, "from": {"steps": "count"}},
      {"key": "l", "action": "ochazuke.list.column", "args": {"delta": 1}, "from": {"steps": "count"}},
      {"key": "right", "action": "ochazuke.list.column", "args": {"delta": 1}, "from": {"steps": "count"}},
      {"key": "0", "action": "ochazuke.list.column", "args": {"to": "first"}, "when": "no-count"},
      {"key": "^", "action": "ochazuke.list.column", "args": {"to": "first"}},
      {"key": "$", "action": "ochazuke.list.column", "args": {"to": "last"}},
      {"key": "|", "action": "ochazuke.list.column", "from": {"index": "count"}},
      {"key": "g c", "action": "ochazuke.list.choose-column"},
      {"key": "z >", "action": "ochazuke.list.resize-column", "args": {"delta": 1}, "from": {"steps": "count"}, "hidden": true},
      {"key": "z <", "action": "ochazuke.list.resize-column", "args": {"delta": -1}, "from": {"steps": "count"}, "hidden": true},
      {"key": "z =", "action": "ochazuke.list.reset-columns", "hidden": true},
      {"key": "z p", "action": "ochazuke.list.toggle-pin-column", "hidden": true},
      {"key": "r", "action": "value.edit", "hint": "r/i edit"},
      {"key": "i", "action": "value.edit", "hidden": true},
      {"key": "d d", "action": "value.delete", "hint": "delete"},
      {"key": "o", "action": "value.add", "hint": "add"},
      {"key": "K", "action": "value.rename", "hint": "rename key"},
      {"key": "p", "action": "value.paste", "hint": "put"}
    ]},
    {"context": "rows/count_pending", "extends": "normal", "bindings": []},
    {"context": "viewer/normal", "bindings": [
      {"key": "/", "action": "jq.focus", "hint": "jq query"},
      {"key": "/", "action": "viewer.search"},
      {"key": "n", "action": "viewer.next"},
      {"key": "N", "action": "viewer.previous"},
      {"key": "t", "action": "viewer.type"},
      {"key": "v", "action": "viewer.raw"},
      {"key": "esc", "action": "viewer.clear"},
      {"key": "R", "action": "viewer.load", "hint": "reload"},
      {"key": "e", "action": "viewer.open", "hint": "open"},
      {"key": "p", "action": "viewer.paste", "hint": "paste"},
      {"key": "T", "action": "restructure.show", "hint": "original/edited"},
      {"key": "w", "action": "restructure.write", "hint": "w/W write"},
      {"key": "W", "action": "restructure.write", "args": {"force": true}, "hidden": true},
      {"key": "w", "action": "viewer.write", "hint": "write"},
      {"key": "M", "action": "restructure.open", "hint": "restructure"},
      {"key": "u", "action": "restructure.undo", "hidden": true},
      {"key": "ctrl+r", "action": "restructure.redo", "hidden": true},
      {"key": "q", "action": "app.quit"},
      {"key": "Q", "action": "app.quit", "args": {"force": true}, "hint": "quit without writing", "hidden": true}
    ]},
    {"context": "shape/normal", "bindings": [
      {"key": "enter", "action": "outline.fold"},
      {"key": "y", "action": "shape.yank"},
      {"key": "s", "action": "shape.send", "hint": "send"},
      {"key": "m", "action": "jq.mode", "hint": "query mode"}
    ]},
    {"context": "shape/query", "bindings": [
      {"key": "m", "action": "jq.mode", "hint": "edit mode"},
      {"key": "esc", "action": "jq.mode", "args": {"to": "edit"}, "hidden": true},
      {"key": ".", "action": "jq.path", "hint": ". path"},
      {"key": "|", "action": "jq.pipe", "hint": "| pipe"},
      {"key": "]", "action": "jq.close", "hint": "] } ) out"},
      {"key": "]", "action": "jq.iterate", "hint": "] each"},
      {"key": "}", "action": "jq.close", "hidden": true},
      {"key": ")", "action": "jq.close", "hidden": true},
      {"key": "[", "action": "jq.open", "args": {"bracket": "["}, "hint": "[ { open"},
      {"key": "{", "action": "jq.open", "args": {"bracket": "{"}, "hidden": true},
      {"key": "(", "action": "jq.open", "args": {"bracket": "("}, "hidden": true},
      {"key": ",", "action": "jq.comma", "hint": ", comma"},
      {"key": "a", "action": "jq.anchor", "hint": "anchor"},
      {"key": "backspace", "action": "jq.erase", "hint": "erase"},
      {"key": "u", "action": "jq.undo", "hidden": true},
      {"key": "ctrl+r", "action": "jq.redo", "hidden": true},
      {"key": "ctrl+f", "action": "jq.function", "hint": "function"},
      {"key": "enter", "action": "outline.fold", "hidden": true}
    ]},
    {"context": "restructure/normal", "bindings": [
      {"key": "tab", "action": "restructure.show", "hint": "other side"},
      {"key": "L", "action": "restructure.layout", "hint": "layout"},
      {"key": "u", "action": "restructure.undo"},
      {"key": "ctrl+r", "action": "restructure.redo"},
      {"key": "w", "action": "restructure.write", "hint": "w/W write"},
      {"key": "W", "action": "restructure.write", "args": {"force": true}, "hidden": true},
      {"key": "q", "action": "restructure.close", "hint": "back"},
      {"key": "Q", "action": "app.quit", "args": {"force": true}, "hint": "quit without writing", "hidden": true}
    ]},
    {"context": "node/normal", "bindings": [
      {"key": "> >", "action": "node.indent", "args": {"into": "previous"}, "hint": "nest"},
      {"key": "< <", "action": "node.dedent", "hint": "out"},
      {"key": "g >", "action": "node.indent", "args": {"into": "next"}, "hint": "nest below"},
      {"key": "S", "action": "node.wrap", "hint": "wrap"},
      {"key": "> j", "action": "node.indent", "args": {"into": "previous", "with": "next"}, "hint": "nest +next"},
      {"key": "> k", "action": "node.indent", "args": {"into": "previous", "with": "previous"}, "hint": "nest +previous"},
      {"key": ">", "action": "ochazuke.key.ignore", "hint": "prefix", "hidden": true},
      {"key": "<", "action": "ochazuke.key.ignore", "hint": "prefix", "hidden": true},
      {"key": "t", "action": "node.array", "hint": "array"},
      {"key": "t", "action": "node.object", "hint": "object"},
      {"key": "r", "action": "node.rename", "hint": "rename"},
      {"key": "d d", "action": "node.delete", "hint": "delete"},
      {"key": "y y", "action": "node.yank", "hint": "yank"},
      {"key": "p", "action": "node.put", "hint": "p/P put"},
      {"key": "P", "action": "node.put", "args": {"before": true}, "hint": "put above", "hidden": true},
      {"key": "d", "action": "restructure.delete", "hint": "delete selection"},
      {"key": "y", "action": "restructure.yank", "hint": "yank selection"},
      {"key": "m", "action": "jq.mode", "hint": "query mode"}
    ]},
    {"context": "node/query", "bindings": [
      {"key": "m", "action": "jq.mode", "hint": "edit mode"},
      {"key": "esc", "action": "jq.mode", "args": {"to": "edit"}, "hidden": true},
      {"key": ".", "action": "jq.path", "hint": ". path"},
      {"key": "|", "action": "jq.pipe", "hint": "| pipe"},
      {"key": "]", "action": "jq.close", "hint": "] } ) out"},
      {"key": "]", "action": "jq.iterate", "hint": "] each"},
      {"key": "}", "action": "jq.close", "hidden": true},
      {"key": ")", "action": "jq.close", "hidden": true},
      {"key": "[", "action": "jq.open", "args": {"bracket": "["}, "hint": "[ { open"},
      {"key": "{", "action": "jq.open", "args": {"bracket": "{"}, "hidden": true},
      {"key": "(", "action": "jq.open", "args": {"bracket": "("}, "hidden": true},
      {"key": ",", "action": "jq.comma", "hint": ", comma"},
      {"key": "a", "action": "jq.anchor", "hint": "anchor"},
      {"key": "backspace", "action": "jq.erase", "hint": "erase"},
      {"key": "u", "action": "jq.undo", "hidden": true},
      {"key": "ctrl+r", "action": "jq.redo", "hidden": true},
      {"key": "ctrl+f", "action": "jq.function", "hint": "function"}
    ]},
    {"context": "ochazuke.outline/query", "bindings": [
      {"key": "h", "action": "ochazuke.outline.collapse"},
      {"key": "left", "action": "ochazuke.outline.collapse", "hidden": true},
      {"key": "l", "action": "ochazuke.outline.expand"},
      {"key": "right", "action": "ochazuke.outline.expand", "hidden": true}
    ]},
    {"context": "ochazuke.outline-row/query", "extends": "normal", "bindings": []},
    {"context": "ochazuke.list/query", "extends": "normal", "bindings": []},
    {"context": "viewer/query", "extends": "normal", "bindings": []},
    {"context": "app/query", "extends": "normal", "bindings": []},
    {"context": "ochazuke.outline/normal", "bindings": [
      {"key": "o", "action": "restructure.add-key", "args": {"where": "below"}, "hint": "o/O new key"},
      {"key": "O", "action": "restructure.add-key", "args": {"where": "above"}, "hidden": true},
      {"key": "a", "action": "restructure.add-key", "args": {"where": "child"}, "hidden": true},
      {"key": "tab", "unbind": true},
      {"key": "shift+tab", "unbind": true},
      {"key": "i", "unbind": true},
      {"key": "d d", "unbind": true}
    ]},
    {"context": "ochazuke.outline-line/insert", "bindings": [
      {"key": "tab", "unbind": true},
      {"key": "shift+tab", "unbind": true}
    ]},
    {"context": "item/normal", "bindings": [
      {"key": "enter", "action": "item.open"},
      {"key": "y", "action": "item.yank"}
    ]},
    {"context": "field/normal", "bindings": [
      {"key": "enter", "action": "field.open"},
      {"key": "y", "action": "field.yank"}
    ]},
    {"context": "line/normal", "bindings": [
      {"key": "y", "action": "line.yank"}
    ]},
    {"context": "entry/normal", "bindings": [
      {"key": "enter", "action": "entry.open"},
      {"key": "l", "action": "entry.open"},
      {"key": "h", "action": "entry.up"},
      {"key": "backspace", "action": "entry.up"},
      {"key": "y", "action": "entry.yank"}
    ]},
    {"context": "detail/normal", "bindings": [
      {"key": "q", "action": "modal.pop"}
    ]},
    {"context": "value-input/insert", "bindings": [
      {"key": "enter", "action": "value-input.accept", "hint": "set"},
      {"key": "esc", "action": "value-input.accept", "hint": "set", "hidden": true}
    ]},
    {"context": "jq-input/insert", "bindings": [
      {"key": "esc", "action": "jq.leave", "hint": "leave"},
      {"key": "enter", "action": "jq.leave", "hidden": true},
      {"key": "ctrl+v", "action": "ochazuke.input.select", "args": {"shape": "char"}, "hint": "select"},
      {"key": "ctrl+f", "action": "jq.function", "hint": "function"},
      {"key": "tab", "action": "jq.next-slot", "hint": "next slot"}
    ]},
    {"context": "jq-input/normal", "bindings": [
      {"key": "esc", "action": "jq.leave", "hint": "leave"}
    ]},
    {"context": "jq-input/visual", "bindings": [
      {"key": "[", "action": "jq.wrap", "args": {"open": "["}, "hint": "[ { ( wrap"},
      {"key": "{", "action": "jq.wrap", "args": {"open": "{"}, "hidden": true},
      {"key": "(", "action": "jq.wrap", "args": {"open": "("}, "hidden": true}
    ]},
    {"context": "query/insert", "bindings": [
      {"key": "enter", "action": "query.commit"},
      {"key": "esc", "action": "query.cancel"}
    ]}
  ]
}
