{
  "values": {"modes.edit-gate": true},
  "name": "journey 01: read a minified API dump (open from recent, tree, table, flat, folded JSON, yank, zoom, quit)",
  "width": 120,
  "height": 30,
  "fixture": "empty",
  "seed": {"files": ["jobs/orders.min.json", "jobs/package.json"]},
  "area": "journeys",
  "script": [
    "e", "ctrl+o", {"type": "orders"}, "enter", {"job": "viewer.open", "state": "done"}, "j", "ctrl+w", "l", "ctrl+d", "G", "g", "g",
    "tab", "tab", "j", "z", "c", "j", "z", "M", "z", "R", "%", "%",
    "3", "j", "y", "y", "ctrl+w", "o", "ctrl+d", "ctrl+w", "=", "ctrl+w", "h", "k",
    "q"
  ],
  "expect": [
    {"after": 1, "focus": "path-chooser/query", "contains": ["No document is open.", "Run viewer.open", "choose path"]},
    {"after": 3, "contains": ["browse [recent]", "/jobs/orders.min."]},
    {"after": 5, "mode": "shape", "contains": ["Structure · unchanged", "Object .", "data  page", "[25]  {2}", "string|null?"]},
    {"after": 6, "contains": ["Table .data  1/25", "ORD-10", "shipped"]},
    {"after": 8, "mode": "table"},
    {"after": 9, "contains": ["Table .data  11/25"]},
    {"after": 10, "contains": ["Table .data  25/25"]},
    {"after": 12, "contains": ["Table .data  1/25"]},
    {"after": 13, "mode": "flat", "contains": ["Flat .data", ".data[0].id = \"ORD-1001\"", ".data[0].customer.email = \"kai.jade@example.com\""]},
    {"after": 14, "mode": "json", "contains": ["JSON .data", "\"id\": \"ORD-1001\"", "\"customer\": {"]},
    {"after": 17, "contains": ["{… 6 keys},", "\"id\": \"ORD-1002\""]},
    {"after": 20, "contains": ["{… 7 keys},"], "lacks": ["\"id\": \"ORD-1002\""]},
    {"after": 22, "contains": ["\"id\": \"ORD-1002\""], "lacks": ["{… 6 keys}"]},
    {"after": 28, "register": "{\n  \"name\": \"Kai Abe\",\n  \"email\": \"kai.abe@example.com\"\n}"},
    {"after": 30, "lacks": ["Structure · unchanged"]},
    {"after": 33, "contains": ["Structure · unchanged", "JSON .data"]},
    {"after": 36, "mode": "shape", "contains": ["Object .", "data  page"]},
    {"quit": true}
  ],
  "notes": [
    {"after": 1, "keys": "e", "note": "o-json with no file says how to open one; e opens the path chooser"},
    {"after": 3, "keys": "ctrl+o type \"orders\"", "note": "ctrl+o switches to the recent files; typing narrows them"},
    {"after": 5, "keys": "enter job viewer.open", "note": "enter opens it: one minified line becomes a structure tree; the root object shows its two keys"},
    {"after": 6, "keys": "j", "note": "j onto .data: the data pane shows the 25 orders as a table"},
    {"after": 8, "keys": "ctrl+w l", "note": "ctrl+w l moves into the table (TABLE)"},
    {"after": 9, "keys": "ctrl+d", "note": "ctrl+d pages half a screen down"},
    {"after": 10, "keys": "G", "note": "G to the last order"},
    {"after": 12, "keys": "g g", "note": "g g back to the first"},
    {"after": 13, "keys": "tab", "note": "tab cycles the view: every leaf as a path = value line (FLAT)"},
    {"after": 14, "keys": "tab", "note": "tab again: the pretty-printed JSON (JSON)"},
    {"after": 17, "keys": "j z c", "note": "j onto the first order, z c folds it"},
    {"after": 20, "keys": "j z M", "note": "z M folds every order: 25 one-line records"},
    {"after": 22, "keys": "z R", "note": "z R opens them all again"},
    {"after": 24, "keys": "% %", "note": "% jumps to the matching bracket and back"},
    {"after": 28, "keys": "3 j y y", "note": "3 j down to the second order's customer; y y yanks that value into the unnamed register (not the system clipboard)"},
    {"after": 30, "keys": "ctrl+w o", "note": "ctrl+w o: only the data pane, the full width for reading"},
    {"after": 31, "keys": "ctrl+d", "note": "ctrl+d reads on"},
    {"after": 33, "keys": "ctrl+w =", "note": "ctrl+w = brings the structure pane back"},
    {"after": 36, "keys": "ctrl+w h k", "note": "ctrl+w h back to the tree, k to the root"},
    {"after": 37, "keys": "q", "note": "q quits: nothing was edited, so it does not ask"}
  ]
}
