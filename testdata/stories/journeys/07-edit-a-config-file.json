{
  "values": {"modes.edit-gate": true},
  "name": "journey 07: edit a config file (package.json: bump the version, undo and redo, add a dependency, sort the keys, write a copy, quit past the unsaved-edits question)",
  "width": 120,
  "height": 30,
  "fixture": "viewer",
  "seed": {"doc": "jobs/package.json"},
  "area": "journeys",
  "script": [
    "ctrl+w", "l", "l", "x", "i", "r", "ctrl+u", {"type": "1.5.0"}, "enter", "u", "ctrl+r", "esc",
    "ctrl+w", "h", "g", "g", "8", "j", "ctrl+w", "l", "i", "o", {"type": "zod"}, "tab",
    {"type": "^3.23.8"}, "enter", "s", "i", "o", "esc", "D", "w", {"type": "package.edited.json"}, "enter", {"job": "restructure.write", "state": "done"}, "i",
    "x", "q", "n", "esc", "Q"
  ],
  "expect": [
    {"after": 3, "mode": "table", "contains": ["name        version  private  scripts", "tea-s…      1.4.2"]},
    {"after": 4, "contains": ["press i first (EDIT)"], "lacks": ["edited [+]"]},
    {"after": 5, "mode": "edit"},
    {"after": 6, "focus": "value-editor/value", "contains": ["was    1.4.2", "value  1.4.2"]},
    {"after": 9, "mode": "edit", "contains": ["1.5.0", "Structure · edited [+]"]},
    {"after": 10, "contains": ["1.4.2", "Structure · unchanged"]},
    {"after": 11, "contains": ["1.5.0", "Structure · edited [+]"]},
    {"after": 12, "mode": "table"},
    {"after": 18, "mode": "shape", "contains": ["Object .dependencies", "react    react-dom"]},
    {"after": 22, "focus": "value-editor/key", "contains": [".dependencies · add after react"]},
    {"after": 26, "mode": "edit", "contains": ["react    zod      react-dom"]},
    {"after": 29, "contains": ["sorted .dependencies"]},
    {"after": 31, "mode": "table", "contains": ["Fields .dependencies", "3 value edits"], "order": ["react      string  ^18.3.1", "react-dom  string  ^18.3.1", "zod        string  ^3.23.8"]},
    {"after": 35, "contains": ["wrote the restructured document to"], "writes": ["jobs/package.edited.json", "state/tables.json"]},
    {"after": 37, "contains": ["4 value edits", "row .dependencies[\"react-dom\"]"]},
    {"after": 38, "quit": false, "contains": ["Quit without writing?"]},
    {"after": 39, "quit": false, "lacks": ["Quit without writing?"]},
    {"quit": true}
  ],
  "notes": [
    {"after": 3, "keys": "ctrl+w l l", "note": "opened as `o-json package.json`; the root object is one row; ctrl+w l into it, l to version"},
    {"after": 4, "keys": "x", "note": "x would delete the value, but TABLE is read-only: the gate says to press i first"},
    {"after": 5, "keys": "i", "note": "i enters EDIT"},
    {"after": 6, "keys": "r", "note": "r opens the value editor on 1.4.2 (was / value / type)"},
    {"after": 9, "keys": "ctrl+u type \"1.5.0\" enter", "note": "ctrl+u clears the field, type 1.5.0, enter sets it: one value edit"},
    {"after": 10, "keys": "u", "note": "u undoes it"},
    {"after": 11, "keys": "ctrl+r", "note": "ctrl+r redoes it"},
    {"after": 12, "keys": "esc", "note": "esc leaves EDIT"},
    {"after": 18, "keys": "ctrl+w h g g 8 j", "note": "back to the tree, down to dependencies: its object is one row of packages"},
    {"after": 22, "keys": "ctrl+w l i o", "note": "into the row, i for EDIT, o adds a key after react: the editor asks for the key"},
    {"after": 26, "keys": "type \"zod\" tab type \"^3.23.8\" enter", "note": "type the key, tab to the value, type it, enter"},
    {"after": 29, "keys": "s i o", "note": "s i o sorts the object's keys (a value patch, one undo step)"},
    {"after": 31, "keys": "esc D", "note": "esc leaves EDIT; D shows the fields: react, react-dom, zod in order (the one-row view keeps its columns where they were)"},
    {"after": 35, "keys": "w type \"package.edited.json\" enter job restructure.write", "note": "w writes the edited document to a new file next to the original (the path chooser starts in its folder); the original is never touched"},
    {"after": 37, "keys": "i x", "note": "one more edit: i, x deletes react (the field under the cursor)"},
    {"after": 38, "keys": "q", "note": "q: an edit no write saved, so it asks"},
    {"after": 39, "keys": "n", "note": "n stays"},
    {"after": 41, "keys": "esc Q", "note": "Q quits without writing (Vim's :q!)"}
  ]
}
